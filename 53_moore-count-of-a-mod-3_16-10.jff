			<y>150.0</y>
			<initial/>
			<output>0</output>
		</state>
		<state id="1" name="q1">
			<x>300.0</x>
			<y>150.0</y>
			<output>1</output>
		</state>
		<state id="2" name="q2">
			<x>500.0</x>
